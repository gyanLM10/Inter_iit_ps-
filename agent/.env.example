# Environment configuration for the RCA Agent
# Copy this to .env and fill in your API key

# LLM Provider: "google" or "openai"
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o

# API Keys (set one based on your LLM_PROVIDER)
GOOGLE_API_KEY=your-google-api-key-here
OPENAI_API_KEY=your-openai-api-key-here

# MCP Server URLs (default for local development / port-forwarded)
K8S_MCP_URL=http://localhost:3000
PROMETHEUS_MCP_URL=http://localhost:3001
LOKI_MCP_URL=http://localhost:3002

# Agent Behavior
MAX_ITERATIONS=5
CONFIDENCE_THRESHOLD=0.9
TARGET_NAMESPACE=workload
